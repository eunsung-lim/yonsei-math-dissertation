\providecommand \babel@aux [2]{\global \let \babel@toc \@gobbletwo }
\@nameuse{bbl@beforestart}
\babel@aux{english}{}
\@writefile{toc}{\ttl@change@i {\@ne }{chapter}{0pt}{}{\bfseries \chaptername \ \thecontentslabel .\quad }{}{\bfseries \dotfill \contentspage }\relax }
\@writefile{toc}{\ttl@change@v {chapter}{}{}{}\relax }
\@writefile{toc}{\ttl@change@i {\@ne }{section}{15pt}{}{\thecontentslabel \quad }{}{\dotfill \contentspage }\relax }
\@writefile{toc}{\ttl@change@v {section}{}{}{}\relax }
\@writefile{toc}{\ttl@change@i {\@ne }{subsection}{30pt}{}{\thecontentslabel \quad }{}{\dotfill \contentspage }\relax }
\@writefile{toc}{\ttl@change@v {subsection}{}{}{}\relax }
\@writefile{toc}{\contentsline {chapter}{\bfseries  List of Figures}{ii}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\bfseries  List of Tables}{iii}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\bfseries  Abstract}{iv}{section*.4}\protected@file@percent }
\citation{EXAMPLE}
\@writefile{toc}{\contentsline {chapter}{\numberline {1}CHAPTER EXAMPLE}{1}{chapter.1}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{chap:1}{{1}{1}{CHAPTER EXAMPLE}{chapter.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {1.1}SECTION EXAMPLE}{1}{section.1.1}\protected@file@percent }
\newlabel{sec:1}{{1.1}{1}{SECTION EXAMPLE}{section.1.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1.1}SUBSECTION EXAMPLE}{1}{subsection.1.1.1}\protected@file@percent }
\newlabel{subsec:1.1}{{1.1.1}{1}{SUBSECTION EXAMPLE}{subsection.1.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces CAPTION}}{1}{figure.caption.6}\protected@file@percent }
\newlabel{fig:example}{{1.1.1}{1}{SUBSECTION EXAMPLE}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1.1}{\ignorespaces Example Table}}{1}{table.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:example}{{1.1}{1}{Example Table}{table.caption.7}{}}
\@writefile{toc}{\contentsline {chapter}{\numberline {2}Chapter 2}{3}{chapter.2}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{chap:2nd}{{2}{3}{Chapter 2}{chapter.2}{}}
\@writefile{toc}{\contentsline {chapter}{\numberline {3}Chapter 3}{6}{chapter.3}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{chap:3rd}{{3}{6}{Chapter 3}{chapter.3}{}}
\bibstyle{abbrv}
\@writefile{toc}{\contentsline {chapter}{\bfseries  Appendix A}{8}{chapter*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{A.1 Additional Proofs}{8}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{A.2 Supplementary Figures}{8}{section*.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{A.3 Data Tables}{8}{section*.11}\protected@file@percent }
\bibdata{reference_thesis}
